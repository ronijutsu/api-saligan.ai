APP_NAME="Batayan.ai"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

# Where uploaded documents, crawled artifacts, template files, and organization
# logos live. Set to `s3` in any deployment running more than one container:
# `local` writes to the container's own filesystem, so a second instance cannot
# read what the first one stored.
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
# Only for S3-compatible stores (MinIO, R2, Spaces). Leave both unset for AWS.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Resend (https://resend.com/docs/send-with-laravel). API key is required.
MAIL_MAILER=resend
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM_ADDRESS="hello@saligan.ai"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700

MEILISEARCH_NO_ANALYTICS=false

# ============================================================================
# Saligan.AI — Legal RAG
# ============================================================================

# Frontend origin (Nuxt dev server); must be listed for Sanctum SPA auth + CORS
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Supabase Auth (identity provider). Keys from Settings > API.
# SUPABASE_PUBLISHABLE_KEY is the anon key, SUPABASE_SECRET_KEY the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# Add-on integrations (Google Workspace / Microsoft SharePoint). OAuth 2.0
# credentials for each provider; tokens are stored encrypted at rest.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Microsoft Entra tenant; `common` allows any work/school account.
MICROSOFT_OAUTH_TENANT=common
# When set, the OAuth redirect_uri points at the Nuxt app's callback
# (/api/integrations/callback) instead of the API itself, so the frontend can
# proxy the consent round-trip. Leave blank to use the API origin — the provider
# then returns the browser to the API's own callback, which redirects back to the
# add-ons page. This must match the Authorised redirect URI registered with the
# provider exactly.
INTEGRATIONS_CALLBACK_BASE_URL=

# AI providers, API keys and models are ai-provider's settings (see
# ai-provider.batayan.ai/.env.example); Laravel only sends what a plan buys.
# The embedding model must match the one ai-provider embeds with: it labels
# the vector index so a model change is caught before it mixes vectors.
EMBEDDING_DIMENSIONS=768
AI_EMBED_PROVIDER=gemini
AI_EMBED_MODEL=gemini-embedding-2

# Web searches one answer may run: deep-research plans get the first, every
# other plan with web search the second.
WEB_SEARCH_MAX_SEARCHES=4
WEB_SEARCH_BASE_MAX_SEARCHES=2

# Private Python AI service. Use a long random value and configure the same
# AI_INTERNAL_SECRET in ai-provider.batayan.ai.
AI_PROVIDER_URL=http://127.0.0.1:8080
AI_INTERNAL_SECRET=
AI_PROVIDER_CONNECT_TIMEOUT=5
AI_PROVIDER_TIMEOUT=300

# Legal crawler capture service (legal-crawler-server). Reads scanned PDFs cited
# from the web via OCR. Empty URL disables it. The secret must equal the
# crawler's CAPTURE_API_SECRET.
LEGAL_CRAWLER_URL=
LEGAL_CRAWLER_SECRET=

# Document processing
DOCUMENT_MAX_SIZE_MB=25
DOCUMENT_CHUNK_SIZE=500
DOCUMENT_CHUNK_OVERLAP=50
DOCUMENT_PROCESSING_QUEUE=document-processing

# Image OCR (fallback is always Ollama; set an API key to use the provider)
DOCUMENT_OCR_PROVIDER=gemini
#DOCUMENT_OCR_MODEL=gemini-3.6-flash

# Case-file classification. Defaults to AI_CHAT_PROVIDER when unset; Gemini
# Flash is far cheaper for what is a short read-and-label call.
DOCUMENT_CLASSIFICATION_PROVIDER=gemini
DOCUMENT_CLASSIFICATION_MODEL=gemini-3.7-flash

# Batched classification, at half the token cost. The document lands in the
# Unfiled queue on upload and sorts itself once the batch ends — usually within
# the hour, up to a day at worst. Supported on Anthropic and Gemini only.
DOCUMENT_CLASSIFICATION_BATCH=true

# Legal source crawler
LEGAL_CRAWLER_ENABLED=true
LEGAL_CRAWLER_SCHEDULE="0 2 * * *"
LEGAL_CRAWLER_USER_AGENT="SaliganAIBot/1.0 (+https://saligan.ai/bot)"
LEGAL_CRAWLER_DELAY_MS=3000
LEGAL_CRAWLER_QUEUE=legal-crawler

# Batched digests, at half the token cost. Covers the bulk producers only — the
# nightly crawl and the `saligan:digest` backfill. A digest generated because a
# reader opened a source stays inline: they are waiting on that one.
LEGAL_DIGEST_BATCH=true

# Deadline reminders (0 disables them entirely)
DEADLINE_REMINDER_LEAD_DAYS=3

# PayMongo billing
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_WEBHOOK_SIGNATURE_PREFIX=paymongo

# PayPal billing
BILLING_GATEWAY=paypal
VETTING_PAYMENT_GATEWAY=paypal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=PHP
PAYPAL_BASE_URL=
PAYPAL_OAUTH_URL=
PAYPAL_TIMEOUT=15
PAYPAL_PLAN_STANDARD_MONTHLY=
PAYPAL_PLAN_STANDARD_ANNUAL=
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_PRO_ANNUAL=
PAYPAL_PLAN_FIRM_MONTHLY=
PAYPAL_PLAN_FIRM_ANNUAL=

#
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
# Password the seeded accounts (test@example.com, admin@example.com) are
# created with in Supabase. Sign-in goes through Supabase, so this is the only
# credential that works for them.
SEED_USER_PASSWORD=password
